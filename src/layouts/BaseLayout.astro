---
import '@/styles/global.css';
import { siteConfig } from '@/data/site.config.mjs';
import { absoluteUrl, resolveOrigin } from '@/lib/origin';

interface Props {
  title?: string;
  description?: string;
  /** Absolutes oder root-relatives OG-Bild. Standard ist die Social Card. */
  image?: string;
  noindex?: boolean;
  /** Extra JSON-LD blocks for this page. */
  structuredData?: Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description = siteConfig.description,
  image = '/og.svg',
  noindex = false,
  structuredData = [],
  bodyClass,
} = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.name}` : `${siteConfig.name} — Reitclub`;
const origin = resolveOrigin(Astro.url);
const canonical = absoluteUrl(Astro.url.pathname, Astro.url);
const ogImage = absoluteUrl(image, Astro.url);

const baseStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteConfig.name,
  alternateName: siteConfig.shortName,
  url: origin,
  description: siteConfig.description,
};
---

<!doctype html>
<html lang={siteConfig.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={siteConfig.themeColor} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Neuigkeiten`} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title ?? siteConfig.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? siteConfig.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify([baseStructuredData, ...structuredData])}
    />
  </head>
  <body class={bodyClass}>
    <div class="backdrop" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <slot />

    <p class="offline-banner" role="status" hidden data-offline>
      Du bist offline. Manche Inhalte sind vielleicht nicht aktuell.
    </p>

    <style>
      .offline-banner {
        position: fixed;
        inset-block-end: 0;
        inset-inline: 0;
        z-index: var(--z-toast);
        padding: var(--space-3);
        background: var(--warning);
        color: var(--text-inverse);
        font-size: var(--text-sm);
        text-align: center;
      }
    </style>

    <script is:inline>
      // Verbindungsstatus. Inline und winzig, damit es vor jeder Hydration greift.
      (function () {
        var banner = document.querySelector('[data-offline]');
        if (!banner) return;
        var sync = function () {
          banner.hidden = navigator.onLine;
        };
        window.addEventListener('online', sync);
        window.addEventListener('offline', sync);
        sync();
      })();
    </script>
  </body>
</html>
