---
/**
 * Inline-Icon. Icons sind eingebettete SVG (keine Icon-Schrift, kein
 * Netzwerk-Request) und erben `currentColor`, folgen also automatisch den
 * Design-Tokens.
 */
import { iconPaths, type IconName } from '@/lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  title?: string;
}

const { name, size = 20, class: className, title } = Astro.props;
---

<svg
  class={className}
  style={`--icon-size:${size}px`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : 'true'}
  role={title ? 'img' : undefined}
  focusable="false"
  set:html={(title ? `<title>${title}</title>` : '') + iconPaths[name]}
/>

<style>
  /*
   * Die globale Regel `svg { max-width: 100%; height: auto }` lässt ein Icon in
   * einem inhaltsbasierten Flex- oder Grid-Container auf 0×0 zusammenfallen.
   * Eine echte CSS-Größe verhindert das; Klassen von außen (z. B.
   * `.empty__icon svg`) stechen diese Regel weiterhin.
   */
  svg {
    width: var(--icon-size);
    height: var(--icon-size);
    max-width: none;
  }
</style>
