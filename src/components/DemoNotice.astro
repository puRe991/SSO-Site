---
import Alert from './Alert.astro';

/**
 * Wird überall dort gezeigt, wo Platzhalterinhalte sichtbar sind, damit
 * Demo-Einträge nie für echte Clubdaten gehalten werden.
 */
interface Props {
  what: string;
}

const { what } = Astro.props;
---

<Alert tone="warning" title="Demo-Inhalte">
  Einige {what} auf dieser Seite sind mit <strong>Demo</strong> markiert. Das sind Platzhalter für
  das Layout, keine echten Clubdaten — sie lassen sich im Adminbereich löschen.
</Alert>
