---
import Card from './Card.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { formatDate, formatTime, isoAttr } from '@/lib/format';
import type { ClanEvent, EventStatus } from '@/types';

interface Props {
  event: ClanEvent;
  /** Adds a live countdown for upcoming events. */
  countdown?: boolean;
}

const { event, countdown = false } = Astro.props;

const statusTone: Record<EventStatus, 'primary' | 'danger' | 'neutral' | 'warning'> = {
  upcoming: 'primary',
  live: 'danger',
  completed: 'neutral',
  cancelled: 'warning',
};

const date = formatDate(event.startsAt);
const time = formatTime(event.startsAt);
---

<Card href={`/events/${event.slug}`} class="event-card">
  <div class="event-card__top">
    <div class="event-card__date" aria-hidden="true">
      <span class="event-card__day">{date?.split(' ')[0] ?? '—'}</span>
      <span class="event-card__month">{date?.split(' ')[1] ?? ''}</span>
    </div>
    <div class="event-card__headline">
      <div class="cluster">
        <Badge tone={statusTone[event.status]} size="sm">{event.status}</Badge>
        {event.gameName && <Badge size="sm">{event.gameName}</Badge>}
        {event.isDemo && <Badge tone="warning" size="sm">Demo</Badge>}
      </div>
      <h3 class="event-card__title">{event.title}</h3>
    </div>
  </div>

  <ul class="event-card__meta" role="list">
    <li>
      <Icon name="calendar" size={15} />
      <time datetime={isoAttr(event.startsAt)}>{date ?? '—'}{time ? `, ${time}` : ''}</time>
    </li>
    {
      event.hostName && (
        <li>
          <Icon name="user" size={15} />
          {event.hostName}
        </li>
      )
    }
    <li>
      <Icon name="users" size={15} />
      {event.participantCount}
      {event.participantLimit ? ` / ${event.participantLimit}` : ''} participants
    </li>
  </ul>

  {
    countdown && event.status === 'upcoming' && (
      <p class="event-card__countdown" data-countdown={isoAttr(event.startsAt)} aria-live="off">
        <Icon name="clock" size={15} />
        <span>Starts soon</span>
      </p>
    )
  }
</Card>

{
  countdown && (
    <script>
      // Progressive enhancement: without JS the card still shows date and time.
      const format = (ms: number) => {
        if (ms <= 0) return 'Starting now';
        const totalMinutes = Math.floor(ms / 60000);
        const days = Math.floor(totalMinutes / 1440);
        const hours = Math.floor((totalMinutes % 1440) / 60);
        const minutes = totalMinutes % 60;
        if (days > 0) return `in ${days}d ${hours}h`;
        if (hours > 0) return `in ${hours}h ${minutes}m`;
        return `in ${minutes}m`;
      };

      const tick = () => {
        document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
          const target = Date.parse(el.dataset.countdown ?? '');
          if (Number.isNaN(target)) return;
          const span = el.querySelector('span');
          if (span) span.textContent = format(target - Date.now());
        });
      };

      tick();
      setInterval(tick, 30_000);
    </script>
  )
}

<style>
  .event-card {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .event-card__top {
    display: flex;
    gap: var(--space-4);
    align-items: start;
  }

  .event-card__date {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 3.4rem;
    padding: var(--space-2) 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-secondary);
    line-height: 1.1;
  }

  .event-card__day {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .event-card__month {
    font-size: 0.62rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .event-card__headline {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .event-card__title {
    font-size: var(--text-lg);
  }

  .event-card__meta {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) 0 0;
    list-style: none;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .event-card__meta li {
    display: flex;
    align-items: center;
    gap: 0.5em;
  }

  .event-card__countdown {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
