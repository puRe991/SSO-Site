---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  href?: string;
  /** Adds the hover lift + border highlight interaction. */
  interactive?: boolean;
  padded?: boolean;
}

const { href, interactive = Boolean(href), padded = true, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'div';
const classes = ['card', interactive && 'card--interactive', padded && 'card--padded', className]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} href={href} {...rest}>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--surface) 92%, transparent), var(--surface));
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .card--padded {
    padding: var(--space-5);
  }

  .card--interactive:hover,
  .card--interactive:focus-visible {
    transform: translateY(-4px);
    border-color: var(--border-brand);
    box-shadow: var(--shadow-glow);
  }

  /* Thin brand line that lights up on hover. */
  .card--interactive::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--primary), transparent);
    opacity: 0;
    transition: opacity var(--duration) var(--ease-out);
  }

  .card--interactive:hover::before,
  .card--interactive:focus-visible::before {
    opacity: 1;
  }
</style>
