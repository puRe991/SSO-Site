---
/**
 * Clublogo.
 *
 * Ein selbst gezeichnetes Hufeisen plus Schriftzug — es wird kein Spiellogo und
 * keine fremde Grafik verwendet. Sobald es ein echtes Clublogo gibt, die Datei
 * nach /public legen und hier einbinden; damit zieht die ganze Seite auf einmal
 * nach.
 */
import { siteConfig } from '@/data/site.config.mjs';

interface Props {
  variant?: 'full' | 'compact';
  href?: string | null;
  class?: string;
}

const { variant = 'full', href = '/', class: className } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['logo', `logo--${variant}`, className]} href={href ?? undefined}>
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="36" height="36" fill="none" aria-hidden="true">
      <defs>
        <linearGradient id="ft-mark" x1="6" y1="4" x2="34" y2="36">
          <stop offset="0%" stop-color="var(--gold-300)"></stop>
          <stop offset="55%" stop-color="var(--gold-500)"></stop>
          <stop offset="100%" stop-color="var(--rust-500)"></stop>
        </linearGradient>
      </defs>
      <circle cx="20" cy="20" r="18" stroke="var(--border-strong)" stroke-width="1.5"></circle>
      <path
        d="M14.6 32.4C10.8 29.9 8.6 25.8 8.6 21a11.4 11.4 0 0 1 22.8 0c0 4.8-2.2 8.9-6 11.4"
        stroke="url(#ft-mark)"
        stroke-width="2.6"
        stroke-linecap="round"></path>
      <path
        d="M11.4 32.4h4.2M24.4 32.4h4.2"
        stroke="url(#ft-mark)"
        stroke-width="2.6"
        stroke-linecap="round"></path>
      <circle cx="11.9" cy="12.9" r="0.85" fill="url(#ft-mark)"></circle>
      <circle cx="28.1" cy="12.9" r="0.85" fill="url(#ft-mark)"></circle>
      <circle cx="8.6" cy="21" r="0.85" fill="url(#ft-mark)"></circle>
      <circle cx="31.4" cy="21" r="0.85" fill="url(#ft-mark)"></circle>
      <circle cx="11" cy="28" r="0.85" fill="url(#ft-mark)"></circle>
      <circle cx="29" cy="28" r="0.85" fill="url(#ft-mark)"></circle>
    </svg>
  </span>
  <span class="logo__text">
    {
      variant === 'full' ? (
        <>
          <span class="logo__name">{siteConfig.name}</span>
          <span class="logo__tagline">Reitclub</span>
        </>
      ) : (
        <span class="logo__name">{siteConfig.shortName}</span>
      )
    }
  </span>
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--text);
  }

  .logo:hover {
    color: var(--text);
  }

  .logo__mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    filter: drop-shadow(0 0 12px var(--glow));
    transition: transform var(--duration) var(--ease-out);
  }

  /*
   * Explizite Größe: die globale Regel `svg { max-width: 100%; height: auto }`
   * lässt ein SVG in einem inhaltsbasierten Grid-Container sonst auf 0×0
   * zusammenfallen — die width/height-Attribute allein reichen dort nicht.
   */
  .logo__mark svg {
    width: 36px;
    height: 36px;
    max-width: none;
  }

  .logo--compact .logo__mark svg {
    width: 30px;
    height: 30px;
  }

  .logo:hover .logo__mark {
    transform: rotate(-6deg) scale(1.04);
  }

  .logo__text {
    display: grid;
    line-height: 1.05;
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  @media (max-width: 420px) {
    .logo__name {
      font-size: var(--text-base);
    }
  }
</style>
