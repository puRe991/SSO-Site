---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  align?: 'start' | 'center';
}

const { eyebrow, title, description, href, linkLabel = 'View all', align = 'start' } = Astro.props;
---

<div class:list={['section-header', `section-header--${align}`]}>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="section-header__title">{title}</h2>
    {description && <p class="section-header__description">{description}</p>}
  </div>
  {
    href && (
      <a class="section-header__link" href={href}>
        {linkLabel}
        <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .section-header--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-header__title {
    margin-top: var(--space-2);
  }

  .section-header__description {
    margin-top: var(--space-3);
    max-width: 60ch;
    color: var(--text-muted);
  }

  .section-header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .section-header__link:hover {
    color: var(--text);
  }

  .section-header__link span {
    transition: transform var(--duration) var(--ease-out);
  }

  .section-header__link:hover span {
    transform: translateX(3px);
  }
</style>
