---
import type { PresenceStatus } from '@/types';

interface Props {
  status: PresenceStatus;
  /** Nur der Punkt, z. B. als Overlay auf einem Avatar. */
  compact?: boolean;
}

const { status, compact = false } = Astro.props;

const labels: Record<PresenceStatus, string> = {
  online: 'Online',
  away: 'Abwesend',
  dnd: 'Bitte nicht stören',
  offline: 'Offline',
};
---

<span class:list={['status', `status--${status}`, compact && 'status--compact']}>
  <span class="status__dot" aria-hidden="true"></span>
  {compact ? <span class="visually-hidden">{labels[status]}</span> : labels[status]}
</span>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .status__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--status-offline);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--status-offline) 22%, transparent);
  }

  .status--online .status__dot {
    background: var(--status-online);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--status-online) 25%, transparent);
  }
  .status--online {
    color: var(--status-online);
  }
  .status--away .status__dot {
    background: var(--status-away);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--status-away) 25%, transparent);
  }
  .status--dnd .status__dot {
    background: var(--status-dnd);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--status-dnd) 25%, transparent);
  }

  .status--compact {
    gap: 0;
  }
</style>
