---
import PageLayout from '@/layouts/PageLayout.astro';
import AchievementCard from '@/components/AchievementCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import DemoNotice from '@/components/DemoNotice.astro';
import { listAchievements } from '@/server/services/content';

const achievements = await listAchievements(Astro.locals);
const hasDemo = achievements.some((achievement) => achievement.isDemo);
---

<PageLayout title="Erfolge" description="Meilensteine und Platzierungen des Reitclubs Fairy Tight.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Meilensteine</p>
      <h1>Erfolge</h1>
      <p class="text-muted intro">
        Hier stehen nur Ergebnisse, die der Club selbst eingetragen hat. Auf dieser Seite wird
        nichts erzeugt oder geschätzt.
      </p>

      {hasDemo && <div class="notice"><DemoNotice what="Erfolge" /></div>}

      {
        achievements.length > 0 ? (
          <div class="grid-auto" style="--min-col:320px">
            {achievements.map((achievement) => (
              <AchievementCard achievement={achievement} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Noch keine Erfolge eingetragen."
            description="Turnierergebnisse, Meilensteine und Clubziele werden im Adminbereich gepflegt."
            icon="trophy"
          />
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .intro {
    margin-top: var(--space-2);
    max-width: 60ch;
  }

  .notice {
    margin-block: var(--space-5);
  }
</style>
