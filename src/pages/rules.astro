---
import PageLayout from '@/layouts/PageLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import Alert from '@/components/Alert.astro';
import Card from '@/components/Card.astro';
import { getSettings } from '@/server/services/settings';
import { renderRichText } from '@/lib/text';

const settings = await getSettings(Astro.locals);
const content = settings['rules.content'].trim();

/** Gliederung, die der Club selbst füllt; hier wird kein Regeltext erfunden. */
const sections = [
  'Allgemeines',
  'Umgang miteinander',
  'Kommunikation',
  'Sprachchat',
  'Ausritte und Turniere',
  'Bewerbungen',
  'Moderation',
  'Konsequenzen',
];
---

<PageLayout title="Clubregeln" description="Die Regeln des Reitclubs Fairy Tight.">
  <section class="section">
    <div class="container container-narrow">
      <p class="eyebrow">Leitlinien</p>
      <h1>Clubregeln</h1>

      {
        content ? (
          <div class="prose rules-body" set:html={renderRichText(content)} />
        ) : (
          <>
            <div class="notice">
              <Alert tone="info" title="Regeln noch nicht veröffentlicht">
                Der Club hat seine Regeln noch nicht veröffentlicht. Die Abschnitte unten sind die
                geplante Gliederung — es steht kein Regeltext hier, den der Club nicht geschrieben hat.
              </Alert>
            </div>

            <Card>
              <ol class="outline">
                {sections.map((section) => (
                  <li>
                    <span>{section}</span>
                    <span class="outline__tbd">offen</span>
                  </li>
                ))}
              </ol>
            </Card>

            <div class="notice">
              <EmptyState
                title="Noch keine Regeln hinterlegt."
                description="Die Regeln werden im Adminbereich unter Einstellungen geschrieben und erscheinen sofort hier."
                icon="shield"
              />
            </div>
          </>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .notice {
    margin-block: var(--space-5);
  }

  .rules-body {
    margin-top: var(--space-5);
    max-width: none;
  }

  .outline {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rule;
  }

  .outline li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    counter-increment: rule;
  }

  .outline li::before {
    content: counter(rule) '.';
    margin-inline-end: var(--space-3);
    color: var(--text-subtle);
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .outline li span:first-of-type {
    flex: 1;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .outline__tbd {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }
</style>
