---
import PageLayout from '@/layouts/PageLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import Alert from '@/components/Alert.astro';
import Card from '@/components/Card.astro';
import { getSettings } from '@/server/services/settings';
import { renderRichText } from '@/lib/text';

const settings = await getSettings(Astro.locals);
const content = settings['rules.content'].trim();

/** Section outline the clan can fill in; no rule text is invented here. */
const sections = [
  'General rules',
  'Behaviour',
  'Communication',
  'Voice chat',
  'Games',
  'Applications',
  'Moderation',
  'Sanctions',
];
---

<PageLayout title="Rules" description="The rules of Team Fairy Tight.">
  <section class="section">
    <div class="container container-narrow">
      <p class="eyebrow">Guidelines</p>
      <h1>Clan rules</h1>

      {
        content ? (
          <div class="prose rules-body" set:html={renderRichText(content)} />
        ) : (
          <>
            <div class="notice">
              <Alert tone="info" title="Rules not published yet">
                The clan has not published its rules yet. The sections below are the planned
                structure — no rule text is shown that the clan has not written.
              </Alert>
            </div>

            <Card>
              <ol class="outline">
                {sections.map((section) => (
                  <li>
                    <span>{section}</span>
                    <span class="outline__tbd">TBD</span>
                  </li>
                ))}
              </ol>
            </Card>

            <div class="notice">
              <EmptyState
                title="No rules available."
                description="Rules are written in the admin area under Settings and appear here immediately."
                icon="shield"
              />
            </div>
          </>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .notice {
    margin-block: var(--space-5);
  }

  .rules-body {
    margin-top: var(--space-5);
    max-width: none;
  }

  .outline {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rule;
  }

  .outline li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--border);
    counter-increment: rule;
  }

  .outline li::before {
    content: counter(rule) '.';
    margin-inline-end: var(--space-3);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .outline li span:first-of-type {
    flex: 1;
    font-family: var(--font-display);
    font-weight: 600;
  }

  .outline__tbd {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }
</style>
