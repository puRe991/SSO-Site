---
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import { getSettings } from '@/server/services/settings';
import { renderRichText } from '@/lib/text';
import Icon from '@/components/Icon.astro';
import { clubRules } from '@/data/clan.config';

const settings = await getSettings(Astro.locals);
const content = settings['rules.content'].trim();

---

<PageLayout title="Clubregeln" description="Die Regeln des Clubs Fairy Tide Inc.">
  <section class="section">
    <div class="container container-narrow">
      <p class="eyebrow">Leitlinien</p>
      <h1 style="margin-block-end: var(--space-6, 1.5rem)">Clubregeln</h1>

      {
        content ? (
          <div class="prose rules-body" set:html={renderRichText(content)} />
        ) : (
          <Card>
            <ul class="rule-list" role="list">
              {clubRules.map((rule) => (
                <li>
                  <Icon name="check" size={16} />
                  <span>{rule}</span>
                </li>
              ))}
            </ul>
          </Card>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .rule-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4, 1rem); }
  .rule-list li { display: flex; gap: 0.75rem; align-items: flex-start; }
</style>
