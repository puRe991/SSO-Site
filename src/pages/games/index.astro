---
import PageLayout from '@/layouts/PageLayout.astro';
import GameCard from '@/components/GameCard.astro';
import FilterBar from '@/components/FilterBar.astro';
import EmptyState from '@/components/EmptyState.astro';
import DemoNotice from '@/components/DemoNotice.astro';
import { listGames } from '@/server/services/content';

const params = Astro.url.searchParams;
const query = {
  status: params.get('status') ?? undefined,
  platform: params.get('platform') ?? undefined,
  search: params.get('q') ?? undefined,
};

const games = await listGames(Astro.locals, query);
const platforms = [...new Set(games.flatMap((game) => game.platforms))].sort();
const hasDemo = games.some((game) => game.isDemo);
---

<PageLayout title="Disziplinen" description="Die Disziplinen, in denen Fairy Tight unterwegs ist.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Programm</p>
      <h1>Disziplinen</h1>
      <p class="text-muted intro">
        Hier stehen nur Disziplinen, die der Club wirklich reitet — nichts wird automatisch
        ergänzt.
      </p>

      <div class="controls">
        <FilterBar
          searchValue={query.search ?? ''}
          searchPlaceholder="Disziplinen durchsuchen…"
          groups={[
            {
              name: 'status',
              label: 'Aktivität',
              value: query.status,
              options: [
                { value: 'active', label: 'Aktiv' },
                { value: 'casual', label: 'Gelegentlich' },
                { value: 'inactive', label: 'Pausiert' },
                { value: 'planned', label: 'Geplant' },
              ],
            },
            {
              name: 'platform',
              label: 'Bereich',
              value: query.platform,
              options: platforms.map((platform) => ({ value: platform, label: platform })),
            },
          ]}
        />
      </div>

      {hasDemo && <div class="controls"><DemoNotice what="Disziplinen" /></div>}

      {
        games.length > 0 ? (
          <div class="grid-auto" style="--min-col:280px">
            {games.map((game) => (
              <GameCard game={game} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Keine Disziplinen gefunden."
            description="Leg die Disziplinen des Clubs im Adminbereich an oder setz die Filter zurück."
            icon="horseshoe"
          />
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .intro {
    margin-top: var(--space-2);
    max-width: 60ch;
  }

  .controls {
    margin-block: var(--space-5);
  }
</style>
