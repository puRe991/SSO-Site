---
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import EmptyState from '@/components/EmptyState.astro';
import Card from '@/components/Card.astro';
import Badge from '@/components/Badge.astro';
import Button from '@/components/Button.astro';
import { getSettings } from '@/server/services/settings';
import { getClanStats, getRanks, listGames } from '@/server/services/content';
import { clanConfig } from '@/data/clan.config';
import { isTBD, orTBD } from '@/data/tbd';
import { renderRichText } from '@/lib/text';
import { gameStatusLabel } from '@/lib/labels';

const [settings, stats, games, ranks] = await Promise.all([
  getSettings(Astro.locals),
  getClanStats(Astro.locals),
  listGames(Astro.locals),
  getRanks(Astro.locals),
]);

const description = settings['clan.description'];
const history = settings['clan.history'];
const values = settings['clan.values'];
const goals = settings['clan.goals'];
---

<PageLayout
  title="Der Club"
  description={`Über ${clanConfig.name} — der Reitclub, seine Werte und seine Aktivitäten.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Über uns</p>
      <h1>Über {clanConfig.name}</h1>
      <p class="lead text-muted">{clanConfig.type}</p>

      <dl class="facts">
        <div>
          <dt>Kurzname</dt>
          <dd>{clanConfig.shortName}</dd>
        </div>
        <div>
          <dt>Gegründet</dt>
          <dd>{orTBD(settings['clan.founded'])}</dd>
        </div>
        <div>
          <dt>Mitglieder</dt>
          <dd>{stats.totalMembers ?? '—'}</dd>
        </div>
        <div>
          <dt>Aktive Disziplinen</dt>
          <dd>{stats.activeGames ?? '—'}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Wer wir sind" title="Der Club" />
      {
        isTBD(description) ? (
          <EmptyState
            title="Noch keine Clubbeschreibung."
            description="Diesen Text schreibt der Club selbst im Adminbereich. Bis dahin bleibt hier nichts stehen — die Geschichte von Fairy Tight wird nicht erfunden."
            icon="info"
          />
        ) : (
          <div class="prose" set:html={renderRichText(description)} />
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Geschichte" title="Wie alles anfing" />
      {
        isTBD(history) ? (
          <EmptyState
            title="Die Clubgeschichte ist noch nicht festgehalten."
            description="Gründungsdatum, Meilensteine und die Geschichte des Clubs trägt der Club selbst nach."
            icon="clock"
          />
        ) : (
          <div class="prose" set:html={renderRichText(history)} />
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <div>
        <SectionHeader eyebrow="Wofür wir stehen" title="Werte" />
        {
          values.trim() ? (
            <div class="prose" set:html={renderRichText(values)} />
          ) : (
            <EmptyState title="Noch keine Werte hinterlegt." icon="shield" />
          )
        }
      </div>
      <div>
        <SectionHeader eyebrow="Wohin wir wollen" title="Ziele" />
        {
          goals.trim() ? (
            <div class="prose" set:html={renderRichText(goals)} />
          ) : (
            <EmptyState title="Noch keine Ziele hinterlegt." icon="star" />
          )
        }
      </div>
    </div>
  </section>

  <!-- Rangordnung -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Struktur"
        title="Rangordnung"
        description="Ein änderbares Rangmodell. Diese Ränge sind die Systemvorgabe und lassen sich jederzeit umbenennen, umsortieren oder löschen."
      />
      <ol class="hierarchy" role="list">
        {
          ranks.map((rank, index) => (
            <li class="hierarchy__item">
              <Badge tone={rank.tone}>{rank.label}</Badge>
              {index < ranks.length - 1 && (
                <span class="hierarchy__arrow" aria-hidden="true">
                  ↓
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader eyebrow="Aktivitäten" title="Disziplinen und Community" href="/games" />
      {
        games.length > 0 ? (
          <ul class="games" role="list">
            {games.map((game) => (
              <li>
                <Card href={`/games/${game.slug}`} class="games__item">
                  <span>{game.name}</span>
                  <Badge size="sm">{gameStatusLabel(game.status)}</Badge>
                </Card>
              </li>
            ))}
          </ul>
        ) : (
          <EmptyState
            title="Noch keine Disziplinen eingetragen."
            description="Die Disziplinen des Clubs werden im Adminbereich gepflegt."
            icon="horseshoe"
          />
        )
      }

      <div class="cta">
        <Button href="/members" variant="secondary">Mitglieder kennenlernen</Button>
        <Button href="/join" variant="primary">Mitreiten</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .lead {
    margin-top: var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-6) 0 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .facts dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .facts dd {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .two-col {
    display: grid;
    gap: var(--space-7);
  }

  .hierarchy {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    margin: 0;
    padding: var(--space-5);
    list-style: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--surface) 55%, transparent);
  }

  .hierarchy__item {
    display: grid;
    gap: var(--space-1);
    justify-items: center;
  }

  .hierarchy__arrow {
    color: var(--text-subtle);
    font-size: var(--text-sm);
  }

  .games {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
  }

  .games__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-weight: 600;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (min-width: 860px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
