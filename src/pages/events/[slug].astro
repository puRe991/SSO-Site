---
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/Badge.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import Alert from '@/components/Alert.astro';
import Toast from '@/components/Toast.astro';
import { getEventBySlug, isParticipant } from '@/server/services/content';
import { formatDate, formatTime, isoAttr } from '@/lib/format';
import { renderRichText } from '@/lib/text';
import { CSRF_FIELD } from '@/server/security/csrf';

const { slug } = Astro.params;
const event = slug ? await getEventBySlug(Astro.locals, slug) : null;

if (!event) {
  return Astro.rewrite('/404');
}

const user = Astro.locals.user;
const joined = user ? await isParticipant(Astro.locals, event.id, user.id) : false;
const full =
  event.participantLimit !== null && event.participantCount >= event.participantLimit && !joined;

const status = Astro.url.searchParams.get('status');
const toastMessages: Record<string, string> = {
  joined: 'You are registered for this event.',
  left: 'You have been removed from this event.',
  full: 'This event is already full.',
};
---

<PageLayout
  title={event.title}
  description={event.description ?? `Event of Team Fairy Tight: ${event.title}`}
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: event.title,
      startDate: isoAttr(event.startsAt),
      endDate: isoAttr(event.endsAt) ?? undefined,
      eventStatus:
        event.status === 'cancelled'
          ? 'https://schema.org/EventCancelled'
          : 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
      organizer: event.hostName ? { '@type': 'Person', name: event.hostName } : undefined,
    },
  ]}
>
  <Toast message={status ? toastMessages[status] : null} tone={status === 'full' ? 'danger' : 'success'} />

  <section class="section">
    <div class="container">
      <a class="back" href="/events">← All events</a>

      <div class="layout">
        <div class="layout__main">
          <div class="cluster">
            <Badge tone={event.status === 'live' ? 'danger' : 'primary'}>{event.status}</Badge>
            {event.gameName && <Badge>{event.gameName}</Badge>}
            {event.isDemo && <Badge tone="warning">Demo event</Badge>}
          </div>
          <h1>{event.title}</h1>

          <Card>
            <h2 class="h3">Description</h2>
            {
              event.description ? (
                <div class="prose" set:html={renderRichText(event.description)} />
              ) : (
                <p class="text-muted">No description provided for this event.</p>
              )
            }
          </Card>
        </div>

        <aside class="layout__side">
          <Card>
            <dl class="meta">
              <div>
                <dt><Icon name="calendar" size={15} /> Date</dt>
                <dd><time datetime={isoAttr(event.startsAt)}>{formatDate(event.startsAt) ?? '—'}</time></dd>
              </div>
              <div>
                <dt><Icon name="clock" size={15} /> Time</dt>
                <dd>{formatTime(event.startsAt) ?? '—'}</dd>
              </div>
              <div>
                <dt><Icon name="gamepad" size={15} /> Game</dt>
                <dd>
                  {
                    event.gameSlug ? <a href={`/games/${event.gameSlug}`}>{event.gameName}</a> : '—'
                  }
                </dd>
              </div>
              <div>
                <dt><Icon name="user" size={15} /> Host</dt>
                <dd>{event.hostName ?? '—'}</dd>
              </div>
              <div>
                <dt><Icon name="users" size={15} /> Participants</dt>
                <dd>
                  {event.participantCount}
                  {event.participantLimit ? ` / ${event.participantLimit}` : ''}
                </dd>
              </div>
            </dl>
          </Card>

          <Card>
            <h2 class="h3">Take part</h2>
            {
              event.status === 'cancelled' ? (
                <Alert tone="warning">This event has been cancelled.</Alert>
              ) : !user ? (
                <>
                  <p class="text-muted small">Sign in to register for this event.</p>
                  <Button href={`/login?next=/events/${event.slug}`} variant="primary" full>
                    Login
                  </Button>
                </>
              ) : (
                <form method="post" action={`/api/events/${event.slug}/participate`}>
                  <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />
                  <input type="hidden" name="action" value={joined ? 'leave' : 'join'} />
                  <Button
                    type="submit"
                    variant={joined ? 'ghost' : 'primary'}
                    full
                    disabled={full}
                    aria-disabled={full}
                  >
                    {joined ? 'Cancel registration' : full ? 'Event is full' : 'Take part'}
                  </Button>
                </form>
              )
            }
          </Card>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
  }

  .layout {
    display: grid;
    gap: var(--space-6);
  }

  .layout__main {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .layout__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .meta {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .meta dt {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .small {
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 940px) {
    .layout {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
</style>
