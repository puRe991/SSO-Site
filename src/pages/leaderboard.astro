---
import PageLayout from '@/layouts/PageLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import Alert from '@/components/Alert.astro';

/**
 * Rangliste.
 *
 * Der Unterbau steht (siehe `members.xp` und das XP-Stufenmodell in
 * `data/ranks.ts`), es gibt aber noch keine Datenquelle für Aktivität. Statt
 * erfundener Zahlen sagt die Seite das offen.
 */
const categories = [
  { id: 'clan-xp', label: 'Club-XP' },
  { id: 'activity', label: 'Aktivität' },
  { id: 'events', label: 'Teilnahmen' },
  { id: 'wins', label: 'Siege' },
  { id: 'contributions', label: 'Einsatz für die Community' },
];

const active = Astro.url.searchParams.get('category') ?? 'clan-xp';
const entries: { username: string; slug: string; value: number }[] = [];
---

<PageLayout title="Rangliste" description="Ranglisten des Reitclubs Fairy Tight.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Platzierungen</p>
      <h1>Rangliste</h1>

      <div class="notice">
        <Alert tone="info" title="Noch keine Datenquelle angebunden">
          Das Ranglistensystem steht bereit, es werden aber noch keine Aktivitätsdaten erfasst.
          Sobald eine Quelle angebunden ist (Club-XP, Teilnahmen, Ergebnisse), füllen sich die
          Tabellen von selbst.
        </Alert>
      </div>

      <nav class="chips" aria-label="Ranglisten-Kategorien">
        {
          categories.map((category) => (
            <a
              href={`/leaderboard?category=${category.id}`}
              class:list={['chip', active === category.id && 'chip--active']}
              aria-current={active === category.id ? 'true' : undefined}
            >
              {category.label}
            </a>
          ))
        }
      </nav>

      {
        entries.length > 0 ? (
          <table class="board">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Mitglied</th>
                <th scope="col">Wert</th>
              </tr>
            </thead>
            <tbody>
              {entries.map((entry, index) => (
                <tr>
                  <td>{index + 1}</td>
                  <td>
                    <a href={`/members/${entry.slug}`}>{entry.username}</a>
                  </td>
                  <td>{entry.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <EmptyState title="Noch keine Auswertung vorhanden." icon="star" />
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .notice {
    margin-block: var(--space-5);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .chip {
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
  }

  .chip--active {
    background: color-mix(in oklab, var(--primary) 18%, transparent);
    border-color: var(--border-brand);
    color: var(--text);
  }

  .board {
    width: 100%;
    border-collapse: collapse;
  }

  .board th,
  .board td {
    padding: var(--space-3);
    border-bottom: 1px solid var(--border);
    text-align: start;
  }
</style>
