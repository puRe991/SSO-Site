---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import AdminHeader from '@/components/admin/AdminHeader.astro';
import Card from '@/components/Card.astro';
import Field from '@/components/Field.astro';
import Button from '@/components/Button.astro';
import Alert from '@/components/Alert.astro';
import { getSettings, isSettingKey, setSetting, SETTING_KEYS } from '@/server/services/settings';
import { adminIcons, visibleAdminNav } from '@/lib/admin-nav';
import { can } from '@/data/permissions';
import { CSRF_FIELD, csrfFromForm, verifyCsrf } from '@/server/security/csrf';
import { isTBD } from '@/data/tbd';
import { hasDatabase } from '@/server/database/client';

const user = Astro.locals.user!;
if (!can(user.role, 'manage_settings')) {
  return new Response('Forbidden', { status: 403 });
}

let notice: string | null = null;
let error: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (!verifyCsrf(Astro.request, Astro.cookies, csrfFromForm(form))) {
    error = 'Deine Sitzung ist abgelaufen. Bitte speichere noch einmal.';
  } else if (!hasDatabase(Astro.locals)) {
    error = 'Es ist keine Datenbank eingerichtet.';
  } else {
    for (const [key, value] of form.entries()) {
      if (typeof value !== 'string' || !isSettingKey(key)) continue;
      await setSetting(Astro.locals, key, value.slice(0, 40000));
    }
    notice = 'Einstellungen gespeichert.';
  }
}

const settings = await getSettings(Astro.locals);

/** In den Feldern stehen nur echte Werte — TBD-Platzhalter bleiben leer. */
const valueOf = (key: (typeof SETTING_KEYS)[number]) => (isTBD(settings[key]) ? '' : settings[key]);

const groups = [
  {
    title: 'Club',
    description: 'Texte für die Start- und die Clubseite.',
    fields: [
      { key: 'clan.description' as const, label: 'Clubbeschreibung', type: 'textarea' as const },
      { key: 'clan.history' as const, label: 'Geschichte', type: 'textarea' as const },
      { key: 'clan.values' as const, label: 'Werte', type: 'textarea' as const },
      { key: 'clan.goals' as const, label: 'Ziele', type: 'textarea' as const },
      { key: 'clan.founded' as const, label: 'Gegründet', type: 'text' as const },
    ],
  },
  {
    title: 'Social Media',
    description: 'Auf der Seite erscheinen nur Plattformen mit einer echten URL.',
    fields: [
      { key: 'social.discord' as const, label: 'Discord-Einladungslink', type: 'url' as const },
      { key: 'social.youtube' as const, label: 'YouTube', type: 'url' as const },
      { key: 'social.twitch' as const, label: 'Twitch', type: 'url' as const },
      { key: 'social.instagram' as const, label: 'Instagram', type: 'url' as const },
      { key: 'social.tiktok' as const, label: 'TikTok', type: 'url' as const },
      { key: 'social.x' as const, label: 'X', type: 'url' as const },
      { key: 'social.facebook' as const, label: 'Facebook', type: 'url' as const },
      { key: 'social.steam' as const, label: 'Steam', type: 'url' as const },
      { key: 'contact.email' as const, label: 'Kontakt-E-Mail', type: 'email' as const },
    ],
  },
  {
    title: 'Rechtliches & Regeln',
    description: 'Regeln, Impressum und Datenschutz. Hier wird nichts automatisch erzeugt.',
    fields: [
      { key: 'rules.content' as const, label: 'Clubregeln', type: 'textarea' as const },
      { key: 'imprint.content' as const, label: 'Impressum', type: 'textarea' as const },
      { key: 'privacy.content' as const, label: 'Datenschutzerklärung', type: 'textarea' as const },
    ],
  },
];
---

<DashboardLayout
  title="Admin — Einstellungen"
  heading="Administration"
  nav={visibleAdminNav(user.role)}
  icons={adminIcons}
>
  <AdminHeader
    title="Einstellungen"
    description="Bearbeitbare Inhalte der Seite. Leere Felder bleiben leer und erscheinen auf der Seite als Platzhalter."
  />

  {notice && <div class="block"><Alert tone="success">{notice}</Alert></div>}
  {error && <div class="block"><Alert tone="danger">{error}</Alert></div>}

  <form method="post" class="settings">
    <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />

    {
      groups.map((group) => (
        <Card>
          <h2 class="h3">{group.title}</h2>
          <p class="text-muted small">{group.description}</p>
          <div class="fields">
            {group.fields.map((field) => (
              <Field
                label={field.label}
                name={field.key}
                type={field.type}
                value={valueOf(field.key)}
                rows={6}
              />
            ))}
          </div>
        </Card>
      ))
    }

    <div class="actions">
      <Button type="submit" variant="primary">Einstellungen speichern</Button>
    </div>
  </form>
</DashboardLayout>

<style>
  .block {
    margin-bottom: var(--space-4);
  }

  .settings {
    display: grid;
    gap: var(--space-4);
    max-width: 900px;
  }

  .h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .small {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }

  .fields {
    display: grid;
    gap: var(--space-4);
  }

  .actions {
    position: sticky;
    bottom: var(--space-4);
    display: flex;
    justify-content: end;
  }

  @media (min-width: 760px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .fields > :global(.field:has(textarea)) {
      grid-column: 1 / -1;
    }
  }
</style>
