---
import AuthLayout from '@/layouts/AuthLayout.astro';
import Field from '@/components/Field.astro';
import Button from '@/components/Button.astro';
import Alert from '@/components/Alert.astro';
import { eq } from 'drizzle-orm';
import { getDatabase, schema } from '@/server/database/client';
import { hashPassword, newId } from '@/server/security/crypto';
import { createSession } from '@/server/security/session';
import { CSRF_FIELD, csrfFromForm, verifyCsrf } from '@/server/security/csrf';
import { clientIdentifier, rateLimit } from '@/server/security/rate-limit';
import { registerSchema, fieldErrors, formToObject } from '@/server/validation/schemas';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard', 302);
}

let errors: Record<string, string> = {};
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = formToObject(form);

  if (!verifyCsrf(Astro.request, Astro.cookies, csrfFromForm(form))) {
    errors._form = 'Deine Sitzung ist abgelaufen. Bitte schick das Formular noch einmal ab.';
  } else {
    const database = getDatabase(Astro.locals);
    const limit = await rateLimit(
      database,
      'register',
      clientIdentifier(Astro.request),
      5,
      60 * 60,
    );

    if (!limit.allowed) {
      errors._form = 'Zu viele Registrierungen von diesem Anschluss. Bitte versuch es später noch einmal.';
    } else {
      const parsed = registerSchema.safeParse(values);
      if (!parsed.success) {
        errors = fieldErrors(parsed.error);
      } else if (!database) {
        errors._form = 'Die Registrierung ist nicht verfügbar, weil keine Datenbank eingerichtet ist.';
      } else {
        const email = parsed.data.email;
        const normalized = email.toLowerCase();
        const existing = await database
          .select({ id: schema.users.id })
          .from(schema.users)
          .where(eq(schema.users.emailNormalized, normalized))
          .limit(1);

        if (existing.length > 0) {
          // Nicht verraten, welche Adressen registriert sind.
          errors._form = 'Mit dieser E-Mail-Adresse ist keine Registrierung möglich.';
        } else {
          const id = newId('usr');
          await database.insert(schema.users).values({
            id,
            email,
            emailNormalized: normalized,
            passwordHash: await hashPassword(parsed.data.password),
            role: 'user',
          });
          await createSession(
            database,
            Astro.cookies,
            Astro.url,
            id,
            Astro.request.headers.get('user-agent'),
          );
          return Astro.redirect('/dashboard', 303);
        }
      }
    }
  }
}
---

<AuthLayout title="Registrieren" description="Leg dir ein Konto für die Seite des Reitclubs Fairy Tight an.">
  <div>
    <h1 class="title">Konto anlegen</h1>
    <p class="text-muted subtitle">
      Mit einem Konto meldest du dich für Termine an und pflegst dein Profil. Um die Mitgliedschaft
      im Club bewirbst du dich getrennt davon unter <a href="/join">Mitreiten</a>.
    </p>
  </div>

  {errors._form && <Alert tone="danger">{errors._form}</Alert>}

  <form method="post" novalidate>
    <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />

    <Field
      label="E-Mail"
      name="email"
      type="email"
      required
      value={values.email}
      error={errors.email}
      autocomplete="email"
    />
    <Field
      label="Passwort"
      name="password"
      type="password"
      required
      error={errors.password}
      autocomplete="new-password"
      hint="Mindestens 12 Zeichen, mit Buchstaben und Zahlen."
    />
    <Field
      label="Passwort wiederholen"
      name="passwordConfirm"
      type="password"
      required
      error={errors.passwordConfirm}
      autocomplete="new-password"
    />

    <Button type="submit" variant="primary" size="lg" full>Registrieren</Button>
  </form>

  <p class="text-muted hint">Du hast schon ein Konto? <a href="/login">Anmelden</a>.</p>
</AuthLayout>

<style>
  .title {
    font-size: var(--text-2xl);
  }

  .subtitle {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  form {
    display: grid;
    gap: var(--space-4);
  }

  .hint {
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
