---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
---

<PageLayout title="Da ist etwas schiefgegangen" noindex>
  <section class="section">
    <div class="container error">
      <p class="code" aria-hidden="true">500</p>
      <h1>Da ist etwas schiefgegangen</h1>
      <p class="text-muted">
        Bitte versuch es noch einmal. Wenn es weiter klemmt, meld dich beim Club.
      </p>
      <div class="cluster">
        <Button href="/" variant="primary">Zur Startseite</Button>
        <Button href="/contact" variant="ghost">Kontakt</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .error {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
    text-align: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 18vw, 9rem);
    font-weight: 700;
    line-height: 1;
    color: var(--text-subtle);
  }
</style>
