---
import PageLayout from '@/layouts/PageLayout.astro';
import EmptyState from '@/components/EmptyState.astro';
import Badge from '@/components/Badge.astro';
import Icon from '@/components/Icon.astro';
import { search } from '@/server/services/content';
import type { IconName } from '@/lib/icons';

const term = Astro.url.searchParams.get('q')?.trim() ?? '';
const results = term.length >= 2 ? await search(Astro.locals, term) : [];

const typeIcon: Record<string, IconName> = {
  member: 'users',
  game: 'horseshoe',
  event: 'calendar',
  news: 'news',
  achievement: 'trophy',
};

/** Der Treffertyp kommt englisch aus der Suche und wird erst hier beschriftet. */
const typeLabel: Record<string, string> = {
  member: 'Mitglied',
  game: 'Disziplin',
  event: 'Termin',
  news: 'Neuigkeit',
  achievement: 'Erfolg',
};
---

<PageLayout title="Suche" description="Mitglieder, Disziplinen, Termine, Neuigkeiten und Erfolge durchsuchen." noindex>
  <section class="section">
    <div class="container container-narrow">
      <p class="eyebrow">Alles finden</p>
      <h1>Suche</h1>

      <form class="search-form" method="get" role="search">
        <Icon name="search" size={18} />
        <input
          type="search"
          name="q"
          value={term}
          placeholder="Mitglieder, Disziplinen, Termine, Neuigkeiten…"
          aria-label="Suchbegriff"
          autofocus
        />
        <button type="submit">Suchen</button>
      </form>

      {
        term.length > 0 && term.length < 2 && (
          <p class="text-muted hint">Bitte gib mindestens zwei Zeichen ein.</p>
        )
      }

      {
        results.length > 0 ? (
          <ul class="results" role="list">
            {results.map((result) => (
              <li>
                <a href={result.href}>
                  <span class="results__icon" aria-hidden="true">
                    <Icon name={typeIcon[result.type] ?? 'link'} size={17} />
                  </span>
                  <span class="results__text">
                    <span class="results__title">{result.title}</span>
                    {result.subtitle && <span class="results__subtitle">{result.subtitle}</span>}
                  </span>
                  <Badge size="sm">{typeLabel[result.type] ?? result.type}</Badge>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          term.length >= 2 && (
            <EmptyState
              title="Keine Treffer."
              description={`Für „${term}“ wurde nichts gefunden.`}
              icon="search"
            />
          )
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .search-form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-5);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--background-elevated);
    color: var(--text-subtle);
  }

  .search-form:focus-within {
    border-color: var(--border-brand);
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    padding: 0.6rem 0;
    border: none;
    background: none;
    color: var(--text);
  }

  .search-form input:focus {
    outline: none;
  }

  .search-form button {
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--primary) 18%, transparent);
    border: 1px solid var(--border-brand);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .results {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .results a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--text);
  }

  .results a:hover {
    border-color: var(--border-brand);
  }

  .results__icon {
    color: var(--text-subtle);
  }

  .results__text {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .results__title {
    font-weight: 600;
  }

  .results__subtitle {
    font-size: var(--text-xs);
    color: var(--text-subtle);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hint {
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
  }
</style>
