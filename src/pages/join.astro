---
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import Field from '@/components/Field.astro';
import Button from '@/components/Button.astro';
import Alert from '@/components/Alert.astro';
import Icon from '@/components/Icon.astro';
import { joinRequirements, joinSteps } from '@/data/clan.config';
import { applicationSchema, fieldErrors, formToObject } from '@/server/validation/schemas';
import { CSRF_FIELD, csrfFromForm, verifyCsrf } from '@/server/security/csrf';
import { clientIdentifier, rateLimit } from '@/server/security/rate-limit';
import { getDatabase, schema } from '@/server/database/client';
import { newId } from '@/server/security/crypto';
import { getSettings } from '@/server/services/settings';
import { isTBD } from '@/data/tbd';

let errors: Record<string, string> = {};
let values: Record<string, string> = {};
let submitted = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = formToObject(form);

  if (!verifyCsrf(Astro.request, Astro.cookies, csrfFromForm(form))) {
    errors._form = 'Deine Sitzung ist abgelaufen. Bitte schick das Formular noch einmal ab.';
  } else {
    const database = getDatabase(Astro.locals);
    const limit = await rateLimit(
      database,
      'application',
      clientIdentifier(Astro.request),
      3,
      60 * 60,
    );

    if (!limit.allowed) {
      errors._form = 'Zu viele Bewerbungen von diesem Anschluss. Bitte versuch es später noch einmal.';
    } else {
      const parsed = applicationSchema.safeParse(values);
      if (!parsed.success) {
        errors = fieldErrors(parsed.error);
      } else if (parsed.data.website) {
        // Honeypot ausgefüllt → still annehmen, aber nichts speichern.
        submitted = true;
      } else if (!database) {
        errors._form =
          'Bewerbungen können gerade nicht angenommen werden, weil keine Datenbank eingerichtet ist.';
      } else {
        await database.insert(schema.applications).values({
          id: newId('app'),
          username: parsed.data.username,
          displayName: parsed.data.displayName || null,
          country: parsed.data.country || null,
          games: parsed.data.games || null,
          mainGame: parsed.data.mainGame || null,
          discordUsername: parsed.data.discordUsername,
          motivation: parsed.data.motivation,
          referral: parsed.data.referral || null,
          status: 'submitted',
        });
        submitted = true;
        values = {};
      }
    }
  }
}

const settings = await getSettings(Astro.locals);
const discord = isTBD(settings['social.discord']) ? null : settings['social.discord'];
---

<PageLayout
  title="Mitreiten"
  description="Bewirb dich bei Fairy Tight — Voraussetzungen, Ablauf und Bewerbungsformular."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Aufnahme</p>
      <h1>Reite bei Fairy Tight mit</h1>
      <p class="text-muted intro">
        Wir suchen Reiterinnen und Reiter, die gern gemeinsam unterwegs sind. Lies dir die
        Voraussetzungen durch und schick uns danach deine Bewerbung.
      </p>

      <div class="layout">
        <div class="layout__info">
          <Card>
            <h2 class="h3">Voraussetzungen</h2>
            <ul class="list" role="list">
              {
                joinRequirements.map((requirement) => (
                  <li>
                    <Icon name="check" size={16} />
                    <span>{requirement}</span>
                  </li>
                ))
              }
            </ul>
          </Card>

          <Card>
            <h2 class="h3">So läuft es ab</h2>
            <ol class="steps">
              {
                joinSteps.map((step, index) => (
                  <li>
                    <span class="steps__number" aria-hidden="true">
                      {index + 1}
                    </span>
                    <span>
                      <strong>{step.title}</strong>
                      <span class="text-muted"> — {step.text}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
          </Card>

          <Card>
            <h2 class="h3">Was wir erwarten</h2>
            <p class="text-muted small">
              Für alle Mitglieder gelten die Clubregeln. Bitte lies sie vor deiner Bewerbung:
              <a href="/rules">Clubregeln</a>.
            </p>
            {
              discord && (
                <Button href={discord} variant="ghost" size="sm" full>
                  <Icon name="discord" size={16} /> Frag auf Discord nach
                </Button>
              )
            }
          </Card>
        </div>

        <div class="layout__form">
          <Card>
            <h2 class="h3">Bewerbung</h2>

            {
              submitted ? (
                <Alert tone="success" title="Bewerbung eingegangen">
                  Danke — deine Bewerbung hat den Status <strong>eingegangen</strong>. Der Club
                  schaut sie sich an und meldet sich bei dir auf Discord.
                </Alert>
              ) : (
                <form method="post" novalidate>
                  <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />

                  {errors._form && <Alert tone="danger">{errors._form}</Alert>}

                  <div class="grid">
                    <Field
                      label="Benutzername"
                      name="username"
                      required
                      value={values.username}
                      error={errors.username}
                      maxlength={40}
                      hint="Dein Name im Spiel."
                    />
                    <Field
                      label="Anzeigename"
                      name="displayName"
                      value={values.displayName}
                      error={errors.displayName}
                      maxlength={60}
                    />
                    <Field
                      label="Land"
                      name="country"
                      value={values.country}
                      error={errors.country}
                      maxlength={60}
                      hint="Optional — hilft bei der Zeitplanung über Zeitzonen hinweg."
                    />
                    <Field
                      label="Discord-Name"
                      name="discordUsername"
                      required
                      value={values.discordUsername}
                      error={errors.discordUsername}
                      maxlength={60}
                    />
                    <Field
                      label="Disziplinen, die du reitest"
                      name="games"
                      value={values.games}
                      error={errors.games}
                      maxlength={300}
                      hint="Mit Komma getrennt."
                    />
                    <Field
                      label="Hauptdisziplin"
                      name="mainGame"
                      value={values.mainGame}
                      error={errors.mainGame}
                      maxlength={80}
                    />
                  </div>

                  <Field
                    label="Warum möchtest du in den Club?"
                    name="motivation"
                    type="textarea"
                    required
                    value={values.motivation}
                    error={errors.motivation}
                    maxlength={2000}
                    hint="Mindestens 20 Zeichen."
                  />

                  <Field
                    label="Wie hast du uns gefunden?"
                    name="referral"
                    value={values.referral}
                    error={errors.referral}
                    maxlength={200}
                  />

                  <div class="honeypot" aria-hidden="true">
                    <label>
                      Website
                      <input type="text" name="website" tabindex="-1" autocomplete="off" />
                    </label>
                  </div>

                  <p class="privacy-note">
                    Deine Daten werden nur für diese Bewerbung verwendet. Mehr dazu in der
                    <a href="/privacy">Datenschutzerklärung</a>.
                  </p>

                  <Button type="submit" variant="primary" size="lg" full>Bewerbung absenden</Button>
                </form>
              )
            }
          </Card>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .intro {
    margin-top: var(--space-2);
    max-width: 60ch;
  }

  .layout {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    align-items: start;
  }

  .layout__info {
    display: grid;
    gap: var(--space-4);
  }

  .h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .list,
  .steps {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .list li,
  .steps li {
    display: flex;
    gap: var(--space-3);
    align-items: start;
    color: var(--text-muted);
  }

  .list :global(svg) {
    flex: 0 0 auto;
    margin-top: 0.2em;
    color: var(--success);
  }

  .steps__number {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: var(--radius-full);
    background: color-mix(in oklab, var(--primary) 20%, transparent);
    color: var(--gold-300);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .steps strong {
    color: var(--text);
  }

  form {
    display: grid;
    gap: var(--space-4);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    /* Jedes Feld behält seine eigene Höhe, sonst zieht ein Hinweistext in der
       einen Spalte das Eingabefeld in der anderen mit in die Länge. */
    align-items: start;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .privacy-note,
  .small {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .small {
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1040px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--space-6);
    }
  }
</style>
