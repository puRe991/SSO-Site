---
import PageLayout from '@/layouts/PageLayout.astro';
import Badge from '@/components/Badge.astro';
import NewsCard from '@/components/NewsCard.astro';
import { getNewsBySlug, listNews } from '@/server/services/content';
import { formatDate, isoAttr } from '@/lib/format';
import { excerpt, renderRichText } from '@/lib/text';
import { siteConfig } from '@/data/site.config.mjs';

const { slug } = Astro.params;
const article = slug ? await getNewsBySlug(Astro.locals, slug) : null;

if (!article) {
  return Astro.rewrite('/404');
}

const related = await listNews(Astro.locals, { category: undefined, pageSize: 4 });
const relatedArticles = related.items.filter((item) => item.slug !== article.slug).slice(0, 3);
const published = formatDate(article.publishedAt);
---

<PageLayout
  title={article.title}
  description={article.teaser ?? excerpt(article.content)}
  image={article.imageUrl ?? undefined}
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'NewsArticle',
      headline: article.title,
      datePublished: isoAttr(article.publishedAt),
      author: article.authorName
        ? { '@type': 'Person', name: article.authorName }
        : { '@type': 'Organization', name: siteConfig.name },
      image: article.imageUrl ?? undefined,
    },
  ]}
>
  <article>
    {
      article.imageUrl && (
        <div class="hero-image">
          <img src={article.imageUrl} alt="" loading="eager" />
        </div>
      )
    }

    <section class="section">
      <div class="container container-narrow">
        <a class="back" href="/news">← Alle Neuigkeiten</a>

        <div class="cluster">
          <Badge tone="accent" size="sm">{article.category}</Badge>
          {article.isDemo && <Badge tone="warning" size="sm">Demo</Badge>}
        </div>

        <h1 class="title">{article.title}</h1>

        <p class="meta">
          {published && <time datetime={isoAttr(article.publishedAt)}>{published}</time>}
          {article.authorName && <span>· von {article.authorName}</span>}
        </p>

        {article.teaser && <p class="teaser">{article.teaser}</p>}

        <div class="prose article-body" set:html={renderRichText(article.content)} />

        {
          article.tags.length > 0 && (
            <ul class="tags" role="list">
              {article.tags.map((tag) => (
                <li>
                  <Badge size="sm">#{tag}</Badge>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>
  </article>

  {
    relatedArticles.length > 0 && (
      <section class="section">
        <div class="container">
          <h2 class="related__title">Weitere Neuigkeiten</h2>
          <div class="grid-auto" style="--min-col:280px">
            {relatedArticles.map((item) => (
              <NewsCard article={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</PageLayout>

<style>
  .hero-image {
    max-height: 46svh;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
  }

  .title {
    margin-block: var(--space-3);
  }

  .meta {
    display: flex;
    gap: 0.4em;
    font-size: var(--text-sm);
    color: var(--text-subtle);
  }

  .teaser {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    color: var(--text-muted);
  }

  .article-body {
    margin-top: var(--space-5);
    max-width: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: var(--space-5) 0 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .related__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }
</style>
