---
import PageLayout from '@/layouts/PageLayout.astro';
import Alert from '@/components/Alert.astro';
import { getSettings } from '@/server/services/settings';
import { renderRichText } from '@/lib/text';
import { isTBD } from '@/data/tbd';

const settings = await getSettings(Astro.locals);
const content = settings['imprint.content'];
const hasContent = !isTBD(content);
---

<PageLayout title="Impressum" description="Impressum — Reitclub Fairy Tight." noindex={!hasContent}>
  <section class="section">
    <div class="container container-narrow">
      <h1>Impressum</h1>
      {
        hasContent ? (
          <div class="prose body" set:html={renderRichText(content)} />
        ) : (
          <div class="notice">
            <Alert tone="warning" title="Platzhalter">
              Es wurden noch keine Impressumsangaben hinterlegt. Rechtliche Angaben werden nie
              erfunden — der Betreiber trägt sie im Adminbereich ein.
            </Alert>
          </div>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .body,
  .notice {
    margin-top: var(--space-5);
    max-width: none;
  }
</style>
