---
import PageLayout from '@/layouts/PageLayout.astro';
import MemberCard from '@/components/MemberCard.astro';
import FilterBar from '@/components/FilterBar.astro';
import EmptyState from '@/components/EmptyState.astro';
import Pagination from '@/components/Pagination.astro';
import DemoNotice from '@/components/DemoNotice.astro';
import { getRanks, listGames, listMembers } from '@/server/services/content';

const params = Astro.url.searchParams;
const query = {
  rank: params.get('rank') ?? undefined,
  status: params.get('status') ?? undefined,
  game: params.get('game') ?? undefined,
  search: params.get('q') ?? undefined,
  sort: (params.get('sort') as 'rank' | 'name' | 'joined' | null) ?? 'rank',
  page: Number.parseInt(params.get('page') ?? '1', 10) || 1,
  pageSize: 12,
};

const [ranks, games, members] = await Promise.all([
  getRanks(Astro.locals),
  listGames(Astro.locals),
  listMembers(Astro.locals, query),
]);

const hasDemo = members.items.some((member) => member.isDemo);
---

<PageLayout title="Mitglieder" description="Die Mitglieder des Reitclubs Fairy Tight.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Stall</p>
      <h1>Mitglieder</h1>
      <p class="text-muted intro">
        {members.total} {members.total === 1 ? 'Mitglied' : 'Mitglieder'} gelistet.
      </p>

      <div class="controls">
        <FilterBar
          searchValue={query.search ?? ''}
          searchPlaceholder="Mitglieder durchsuchen…"
          groups={[
            {
              name: 'rank',
              label: 'Rang',
              value: query.rank,
              options: ranks.map((rank) => ({ value: rank.id, label: rank.label })),
            },
            {
              name: 'status',
              label: 'Status',
              value: query.status,
              options: [
                { value: 'online', label: 'Online' },
                { value: 'away', label: 'Abwesend' },
                { value: 'dnd', label: 'Bitte nicht stören' },
                { value: 'offline', label: 'Offline' },
              ],
            },
            {
              name: 'game',
              label: 'Disziplin',
              value: query.game,
              options: games.map((game) => ({ value: game.slug, label: game.name })),
            },
            {
              name: 'sort',
              label: 'Sortierung',
              allLabel: 'Sortierung: Standard',
              value: params.get('sort') ?? undefined,
              options: [
                { value: 'rank', label: 'Nach Rang' },
                { value: 'name', label: 'Nach Name' },
                { value: 'joined', label: 'Nach Eintrittsdatum' },
              ],
            },
          ]}
        />
      </div>

      {hasDemo && <div class="notice"><DemoNotice what="Mitglieder" /></div>}

      {
        members.items.length > 0 ? (
          <div class="grid-auto" style="--min-col:300px">
            {members.items.map((member) => (
              <MemberCard member={member} ranks={ranks} />
            ))}
          </div>
        ) : (
          <EmptyState
            title="Keine Mitglieder gefunden."
            description="Ändere die Filter oder leg im Adminbereich Mitglieder an."
            icon="users"
          />
        )
      }

      <Pagination page={members.page} totalPages={members.totalPages} />
    </div>
  </section>
</PageLayout>

<style>
  .intro {
    margin-top: var(--space-2);
  }

  .controls,
  .notice {
    margin-block: var(--space-5);
  }
</style>
