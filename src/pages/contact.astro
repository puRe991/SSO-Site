---
import PageLayout from '@/layouts/PageLayout.astro';
import Card from '@/components/Card.astro';
import Field from '@/components/Field.astro';
import Button from '@/components/Button.astro';
import Alert from '@/components/Alert.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import Icon from '@/components/Icon.astro';
import { contactSchema, fieldErrors, formToObject } from '@/server/validation/schemas';
import { CSRF_FIELD, csrfFromForm, verifyCsrf } from '@/server/security/csrf';
import { clientIdentifier, rateLimit } from '@/server/security/rate-limit';
import { getDatabase, schema } from '@/server/database/client';
import { newId } from '@/server/security/crypto';
import { getSettings } from '@/server/services/settings';
import { isTBD } from '@/data/tbd';
import type { SocialPlatform } from '@/types';

let errors: Record<string, string> = {};
let values: Record<string, string> = {};
let sent = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = formToObject(form);

  if (!verifyCsrf(Astro.request, Astro.cookies, csrfFromForm(form))) {
    errors._form = 'Deine Sitzung ist abgelaufen. Bitte schick die Nachricht noch einmal ab.';
  } else {
    const database = getDatabase(Astro.locals);
    const limit = await rateLimit(database, 'contact', clientIdentifier(Astro.request), 5, 60 * 60);

    if (!limit.allowed) {
      errors._form = 'Zu viele Nachrichten von diesem Anschluss. Bitte versuch es später noch einmal.';
    } else {
      const parsed = contactSchema.safeParse(values);
      if (!parsed.success) {
        errors = fieldErrors(parsed.error);
      } else if (parsed.data.website) {
        sent = true;
      } else if (!database) {
        errors._form = 'Nachrichten können gerade nicht empfangen werden, weil keine Datenbank eingerichtet ist.';
      } else {
        await database.insert(schema.contactMessages).values({
          id: newId('msg'),
          name: parsed.data.name,
          email: parsed.data.email,
          subject: parsed.data.subject,
          message: parsed.data.message,
        });
        sent = true;
        values = {};
      }
    }
  }
}

const settings = await getSettings(Astro.locals);
const email = isTBD(settings['contact.email']) ? null : settings['contact.email'];
const discord = isTBD(settings['social.discord']) ? null : settings['social.discord'];

const socials: { platform: SocialPlatform; label: string; url: string }[] = [
  { platform: 'discord', label: 'Discord', url: settings['social.discord'] },
  { platform: 'youtube', label: 'YouTube', url: settings['social.youtube'] },
  { platform: 'twitch', label: 'Twitch', url: settings['social.twitch'] },
  { platform: 'instagram', label: 'Instagram', url: settings['social.instagram'] },
  { platform: 'tiktok', label: 'TikTok', url: settings['social.tiktok'] },
  { platform: 'x', label: 'X', url: settings['social.x'] },
  { platform: 'facebook', label: 'Facebook', url: settings['social.facebook'] },
  { platform: 'steam', label: 'Steam', url: settings['social.steam'] },
];
---

<PageLayout title="Kontakt" description="Nimm Kontakt zum Reitclub Fairy Tight auf.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Schreib uns</p>
      <h1>Kontakt</h1>

      <div class="layout">
        <Card>
          <h2 class="h3">Nachricht schreiben</h2>
          {
            sent ? (
              <Alert tone="success" title="Nachricht verschickt">
                Danke — wir melden uns bei dir.
              </Alert>
            ) : (
              <form method="post" novalidate>
                <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />
                {errors._form && <Alert tone="danger">{errors._form}</Alert>}

                <Field label="Name" name="name" required value={values.name} error={errors.name} maxlength={80} />
                <Field
                  label="E-Mail"
                  name="email"
                  type="email"
                  required
                  value={values.email}
                  error={errors.email}
                  autocomplete="email"
                />
                <Field
                  label="Betreff"
                  name="subject"
                  required
                  value={values.subject}
                  error={errors.subject}
                  maxlength={120}
                />
                <Field
                  label="Nachricht"
                  name="message"
                  type="textarea"
                  required
                  value={values.message}
                  error={errors.message}
                  maxlength={2000}
                />

                <div class="honeypot" aria-hidden="true">
                  <label>
                    Website
                    <input type="text" name="website" tabindex="-1" autocomplete="off" />
                  </label>
                </div>

                <Button type="submit" variant="primary" full>Nachricht senden</Button>
              </form>
            )
          }
        </Card>

        <div class="channels">
          <Card>
            <h2 class="h3">Andere Wege</h2>
            <ul class="channel-list" role="list">
              <li>
                <Icon name="discord" size={17} />
                {
                  discord ? (
                    <a href={discord} rel="noopener noreferrer" target="_blank">
                      Discord-Server
                    </a>
                  ) : (
                    <span class="text-muted">Der Discord-Link ist noch nicht veröffentlicht.</span>
                  )
                }
              </li>
              <li>
                <Icon name="inbox" size={17} />
                {
                  email ? (
                    <a href={`mailto:${email}`}>{email}</a>
                  ) : (
                    <span class="text-muted">Es ist noch keine E-Mail-Adresse veröffentlicht.</span>
                  )
                }
              </li>
            </ul>
          </Card>

          <Card>
            <h2 class="h3">Social Media</h2>
            <SocialLinks links={socials} />
            <p class="text-muted small">
              Hier stehen nur Kanäle, die der Club wirklich eingerichtet hat.
            </p>
          </Card>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    align-items: start;
  }

  .channels {
    display: grid;
    gap: var(--space-4);
  }

  .h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  form {
    display: grid;
    gap: var(--space-4);
  }

  .channel-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .channel-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .small {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
  }

  @media (min-width: 940px) {
    .layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
