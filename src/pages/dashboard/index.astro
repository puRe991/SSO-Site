---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Card from '@/components/Card.astro';
import Field from '@/components/Field.astro';
import Button from '@/components/Button.astro';
import Alert from '@/components/Alert.astro';
import Badge from '@/components/Badge.astro';
import Avatar from '@/components/Avatar.astro';
import RankBadge from '@/components/RankBadge.astro';
import EmptyState from '@/components/EmptyState.astro';
import { eq } from 'drizzle-orm';
import { getDatabase, schema } from '@/server/database/client';
import { getRanks, getNotifications } from '@/server/services/content';
import { mapMember } from '@/server/services/mappers';
import { CSRF_FIELD, csrfFromForm, verifyCsrf } from '@/server/security/csrf';
import { fieldErrors, formToObject, passwordChangeSchema, profileSchema } from '@/server/validation/schemas';
import { hashPassword, verifyPassword } from '@/server/security/crypto';
import { canAccessAdmin } from '@/data/permissions';
import type { NavItem } from '@/data/navigation';
import type { IconName } from '@/lib/icons';
import { siteConfig } from '@/data/site.config.mjs';

const user = Astro.locals.user!;
const database = getDatabase(Astro.locals);

let errors: Record<string, string> = {};
let notice: string | null = null;

if (Astro.request.method === 'POST' && database) {
  const form = await Astro.request.formData();
  const values = formToObject(form);

  if (!verifyCsrf(Astro.request, Astro.cookies, csrfFromForm(form))) {
    errors._form = 'Deine Sitzung ist abgelaufen. Bitte versuch es noch einmal.';
  } else if (values.intent === 'profile' && user.memberId) {
    const parsed = profileSchema.safeParse(values);
    if (!parsed.success) {
      errors = fieldErrors(parsed.error);
    } else {
      await database
        .update(schema.members)
        .set({
          displayName: parsed.data.displayName || null,
          bio: parsed.data.bio || null,
          avatarUrl: parsed.data.avatarUrl || null,
          status: parsed.data.status,
          updatedAt: Math.floor(Date.now() / 1000),
        })
        .where(eq(schema.members.id, user.memberId));
      notice = 'Profil gespeichert.';
    }
  } else if (values.intent === 'password') {
    const parsed = passwordChangeSchema.safeParse(values);
    if (!parsed.success) {
      errors = fieldErrors(parsed.error);
    } else {
      const rows = await database
        .select({ passwordHash: schema.users.passwordHash })
        .from(schema.users)
        .where(eq(schema.users.id, user.id))
        .limit(1);
      const current = rows[0];
      if (!current || !(await verifyPassword(parsed.data.currentPassword, current.passwordHash))) {
        errors.currentPassword = 'Das aktuelle Passwort stimmt nicht.';
      } else {
        await database
          .update(schema.users)
          .set({
            passwordHash: await hashPassword(parsed.data.password),
            updatedAt: Math.floor(Date.now() / 1000),
          })
          .where(eq(schema.users.id, user.id));
        notice = 'Passwort geändert.';
      }
    }
  }
}

const [ranks, notifications] = await Promise.all([
  getRanks(Astro.locals),
  getNotifications(Astro.locals, user.id),
]);

const memberRows =
  database && user.memberId
    ? await database.select().from(schema.members).where(eq(schema.members.id, user.memberId)).limit(1)
    : [];
const member = memberRows[0] ? mapMember(memberRows[0]) : null;

const events =
  database
    ? await database
        .select({ event: schema.events })
        .from(schema.eventParticipants)
        .innerJoin(schema.events, eq(schema.events.id, schema.eventParticipants.eventId))
        .where(eq(schema.eventParticipants.userId, user.id))
        .limit(10)
    : [];

const nav: NavItem[] = [
  { label: 'Übersicht', href: '/dashboard', match: '^/dashboard/?$' },
  { label: 'Mitglieder', href: '/members' },
  { label: 'Termine', href: '/events' },
  { label: 'Mitreiten', href: '/join' },
];
const icons: Record<string, IconName> = {
  '/dashboard': 'dashboard',
  '/members': 'users',
  '/events': 'calendar',
  '/join': 'inbox',
};
---

<DashboardLayout title="Mein Bereich" heading="Mitgliederbereich" nav={nav} icons={icons}>
  <header class="head">
    <div>
      <p class="eyebrow">Mein Bereich</p>
      <h1>Willkommen zurück</h1>
      <p class="text-muted">{user.email}</p>
    </div>
    <div class="cluster">
      <Badge tone="accent">{user.role}</Badge>
      {canAccessAdmin(user.role) && <Button href="/admin" variant="secondary" size="sm">Adminbereich</Button>}
    </div>
  </header>

  {notice && <div class="block"><Alert tone="success">{notice}</Alert></div>}
  {errors._form && <div class="block"><Alert tone="danger">{errors._form}</Alert></div>}

  <div class="grid">
    <Card>
      <h2 class="h3">Clubprofil</h2>
      {
        member ? (
          <>
            <div class="profile">
              <Avatar name={member.username} src={member.avatarUrl} status={member.status} size={64} />
              <div>
                <p class="profile__name">{member.username}</p>
                <RankBadge rankId={member.rank} ranks={ranks} size="sm" />
              </div>
            </div>

            <form method="post" novalidate>
              <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />
              <input type="hidden" name="intent" value="profile" />
              <Field label="Anzeigename" name="displayName" value={member.displayName ?? ''} error={errors.displayName} maxlength={60} />
              <Field label="Avatar-URL" name="avatarUrl" type="url" value={member.avatarUrl ?? ''} error={errors.avatarUrl} />
              <Field
                label="Status"
                name="status"
                type="select"
                value={member.status}
                options={[
                  { value: 'online', label: 'Online' },
                  { value: 'away', label: 'Abwesend' },
                  { value: 'dnd', label: 'Bitte nicht stören' },
                  { value: 'offline', label: 'Offline' },
                ]}
              />
              <Field label="Über mich" name="bio" type="textarea" value={member.bio ?? ''} error={errors.bio} maxlength={2000} />
              <Button type="submit" variant="primary" full>Profil speichern</Button>
            </form>
          </>
        ) : (
          <EmptyState
            title="Kein Clubprofil verknüpft."
            description="Dein Konto ist noch mit keinem Clubmitglied verknüpft. Die Clubleitung kann beides verbinden."
            icon="user"
          />
        )
      }
    </Card>

    <div class="column">
      <Card>
        <h2 class="h3">Meine Termine</h2>
        {
          events.length > 0 ? (
            <ul class="list" role="list">
              {events.map(({ event }) => (
                <li>
                  <a href={`/events/${event.slug}`}>{event.title}</a>
                  <span class="text-muted">
                    {new Date(event.startsAt * 1000).toLocaleDateString(siteConfig.locale)}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-muted small">Du bist für keinen Termin angemeldet.</p>
          )
        }
      </Card>

      <Card>
        <h2 class="h3">Benachrichtigungen</h2>
        {
          notifications.length > 0 ? (
            <ul class="list" role="list">
              {notifications.map((item) => (
                <li>
                  {item.href ? <a href={item.href}>{item.title}</a> : <span>{item.title}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-muted small">Keine Benachrichtigungen.</p>
          )
        }
      </Card>

      <Card>
        <h2 class="h3">Passwort ändern</h2>
        <form method="post" novalidate>
          <input type="hidden" name={CSRF_FIELD} value={Astro.locals.csrfToken} />
          <input type="hidden" name="intent" value="password" />
          <Field
            label="Aktuelles Passwort"
            name="currentPassword"
            type="password"
            required
            error={errors.currentPassword}
            autocomplete="current-password"
          />
          <Field
            label="Neues Passwort"
            name="password"
            type="password"
            required
            error={errors.password}
            autocomplete="new-password"
            hint="Mindestens 12 Zeichen."
          />
          <Field
            label="Neues Passwort wiederholen"
            name="passwordConfirm"
            type="password"
            required
            error={errors.passwordConfirm}
            autocomplete="new-password"
          />
          <Button type="submit" variant="secondary" full>Passwort ändern</Button>
        </form>
      </Card>
    </div>
  </div>
</DashboardLayout>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .block {
    margin-top: var(--space-4);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    align-items: start;
  }

  .column {
    display: grid;
    gap: var(--space-4);
  }

  .h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    margin-bottom: var(--space-4);
  }

  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .profile__name {
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  form {
    display: grid;
    gap: var(--space-4);
  }

  .list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .list li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .small {
    font-size: var(--text-sm);
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
</style>
