---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/Button.astro';
---

<PageLayout title="Seite nicht gefunden" noindex>
  <section class="section">
    <div class="container error">
      <p class="code" aria-hidden="true">404</p>
      <h1>Seite nicht gefunden</h1>
      <p class="text-muted">
        Diese Seite gibt es nicht oder sie ist umgezogen.
      </p>
      <div class="cluster">
        <Button href="/" variant="primary">Zur Startseite</Button>
        <Button href="/search" variant="ghost">Seite durchsuchen</Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .error {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-8);
    text-align: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(4rem, 18vw, 9rem);
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(120deg, var(--gold-400), var(--rust-500), var(--pine-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.85;
  }
</style>
